{
  "name": "ems-flasher-js-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Flash the GB USB smart card 64M from the command line or straight from your browser",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "ems-flasher": "tsx packages/cli/src/index.ts",
    "build": "tsc --build",
    "build:web": "npm run build --workspace @ems-flasher-js/web",
    "dev:web": "npm run dev --workspace @ems-flasher-js/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force",
    "clean": "tsc --build --clean"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "usb@2.18.0": true
  }
}
